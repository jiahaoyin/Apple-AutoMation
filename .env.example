# 运行 ./run.sh 时，账号和密码会在终端中提示输入，并自动写入 .env。
# 也可以先手动填写。
APPLE_ID=your@email.com
APPLE_PASSWORD=your_password

# 可选：Firefox / ruyiPage
# FIREFOX_EXECUTABLE=/Applications/Firefox.app/Contents/MacOS/firefox
# FIREFOX_PROFILE_DIR=./data/firefox-apple-automation
# BROWSER_BACKEND=ruyipage          # 唯一浏览器后端；auto 仅作兼容别名
# RUYIPAGE_PYTHON=python3
# BROWSER_PROFILE_MODE=persistent   # persistent | fresh

# 浏览器登录等待（毫秒）
# BROWSER_SIGN_IN_URL=https://appleid.apple.com/sign-in
# RUYIPAGE_BACKEND_TIMEOUT_MS=720000
# RUYIPAGE_KILL_GRACE_MS=5000
# BROWSER_2FA_SETTINGS_AFTER_MS=30000  # need_2fa 后先等待主弹窗；Allow 确认后另有固定 30 秒宽限
# BROWSER_2FA_SETTINGS_FALLBACK=1
# BROWSER_2FA_MANUAL_FALLBACK=1
# BROWSER_2FA_POLL_MS=800
# BROWSER_PRESERVE_ON_FAILURE=1  # 失败时保留 Firefox 供核对
# BROWSER_PRESERVE_ON_SUCCESS=1  # 成功后保留已登录 Firefox 窗口和标签页
# BROWSER_ATTACH_EXISTING=1       # 接管已有 Firefox 会话；仍先执行 Developer-first，再新建 Account 标签页
# BROWSER_ATTACH_ADDRESS=127.0.0.1:9222  # 可选：明确指定 ruyiPage attach 地址
# DEVELOPER_MEMBERSHIP_GATE=0     # 测试默认：Developer 登录确认后，无论会员结果都继续 Account；设为 1 时仅已加入会员继续
# 终端诊断仅接受 shell/export 运行时开关，不从 .env 读取：
# APPLE_AUTOMATION_TERMINAL_DEBUG=1 ./run.sh --skip-mac
# name=                           # 已登录个人信息页采集后写入
# birthday=                       # 已登录个人信息页采集后写入
# developer_membership=           # 已加入 | 未加入 | 未确认（采集后写入）
# OTP 永远不会写入 audit、report、截图、错误文本或 .env。
# BROWSER_PAGE_SETTLE_MIN_MS=2000
# BROWSER_PAGE_SETTLE_MAX_MS=4000

# Mac 系统设置短信验证。所有开关和默认值都在 .env 配置。
# 设为 0 关闭短信验证码自动获取；默认启用
APPLE_AUTOMATION_SMS_ENABLED=1
# 仅保存受信任号码和私有 provider URL；.env 会以 0600 权限写入，且不会提交到 git。
APPLE_AUTOMATION_SMS_PHONE=
APPLE_AUTOMATION_SMS_API_URL=
# 设为 1 可在下一次运行时重新输入号码和 URL；格式校验通过后自动改回 0 并覆盖旧值。
APPLE_AUTOMATION_SMS_RECONFIGURE=0

# 设为 0 关闭短信验证后自动处理条款/Mac密码/iPhone解锁等弹窗；默认启用
APPLE_AUTOMATION_POST_SMS_FINALIZATION_ENABLED=1
