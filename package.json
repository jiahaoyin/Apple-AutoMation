{
  "name": "apple-id-automation",
  "version": "1.0.61",
  "private": true,
  "description": "macOS Apple ID 系统设置登录 + ruyiPage-only account.apple.com 自动化",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "flow": "node scripts/apple-id-full-flow.mjs",
    "flow:browser-only": "node scripts/apple-id-full-flow.mjs --skip-mac",
    "flow:mac-only": "node scripts/apple-id-full-flow.mjs --skip-browser",
    "check": "node scripts/check-environment.mjs",
    "setup": "node scripts/setup-environment.mjs",
    "bump:patch": "node scripts/bump-patch-version.mjs",
    "package": "node scripts/build-release.mjs",
    "package:no-bump": "node scripts/build-release.mjs --no-bump",
    "release": "node scripts/build-release.mjs --upload --clean",
    "release:no-bump": "node scripts/build-release.mjs --no-bump --upload --clean",
    "dump:mac-ui": "osascript scripts/mac-settings-ui-dump.applescript",
    "fill:debug": "node scripts/fill-debug.mjs",
    "check:automation": "osascript scripts/automation-check.applescript",
    "test:2fa-permissions": "node scripts/test-2fa-permissions.mjs",
    "test:2fa-allow": "node scripts/test-2fa-allow.mjs --manual",
    "test:2fa-allow-unit": "node scripts/test-2fa-allow.mjs",
    "test:2fa-settings": "node scripts/test-2fa-settings-code.mjs",
    "test:2fa-sidecar": "node scripts/test-two-fa-sidecar.mjs",
    "test:2fa-settings-unit": "node scripts/test-mac-settings-2fa.mjs",
    "test:mac-settings-sms-verification": "node scripts/test-mac-settings-sms-verification.mjs && node scripts/test-mac-settings-sms-provider.mjs && node scripts/test-mac-settings-sms-provider-coordinator.mjs && node scripts/test-mac-settings-sms-provider-config.mjs",
    "test:account-browser-flow": "node scripts/test-account-browser-flow.mjs",
    "test:flow-audit": "node scripts/test-flow-audit.mjs",
    "test:browser-backend": "node scripts/test-browser-backend.mjs",
    "test:ruyipage-runtime": "node scripts/test-ruyipage-runtime.mjs",
    "test:ruyipage-protocol": "node scripts/test-ruyipage-protocol.mjs",
    "test:ruyipage-flow": "node scripts/test-ruyipage-flow.mjs",
    "test:python-bootstrap": "node scripts/test-python-bootstrap.mjs",
    "test:release-copy-paths": "node scripts/test-release-copy-paths.mjs"
  }
}
